# Copy this file to docker/testserver.env and fill in real values.
# docker/testserver.env is for local/server use only - do not commit it.

# --- Postgres / Kolibri database ---
KOLIBRI_DATABASE_NAME=kolibri
KOLIBRI_DATABASE_USER=kolibri
KOLIBRI_DATABASE_PASSWORD=changeme

# --- Kolibri ---
KOLIBRI_LANG=en
KOLIBRI_HTTP_PORT=8080

# --- Host paths (adjust for the target server's layout) ---
# Directory on the host holding imported content packs (bind-mounted into
# the container at /opt/KOLIBRI_DATA, matching kolibri_helper_scripts' default).
KOLIBRI_DATA_DIR=/opt/KOLIBRI_DATA

# Path to a kolibri_helper_scripts checkout on the host, mounted into the
# container at /kolibri_helper_scripts so its scripts can be run via
# `docker compose exec kolibri ...` without rebuilding the image.
KOLIBRI_HELPER_SCRIPTS_DIR=../../kolibri_helper_scripts
