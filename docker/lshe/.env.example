# Copy to .env (git-ignored) and fill in. Never commit .env.
# Every value below is a placeholder.

# --- Centre ---
# Short code used in report file names, e.g. lshe_<CODE>_2027-03.csv.
# Letters, digits, "_" and "-" only.
KOLIBRI_CENTRE_CODE=CENTRE01
# The server's address on the centre LAN (tablets use http://<this>:8080).
LSHE_BIND_IP=192.168.1.10
# Port for zipped HTML5/H5P content. Change it only if 8081 is taken by
# something else on the server (for example a Guacamole gateway).
LSHE_ZIP_PORT=8081

# --- Database ---
KOLIBRI_DATABASE_NAME=kolibri
KOLIBRI_DATABASE_USER=kolibri
KOLIBRI_DATABASE_PASSWORD=change-me-long-random

# --- First start: facility and device superuser ---
# Remove KOLIBRI_PROVISIONDEVICE_FACILITY after the first start if you prefer
# provisioning by hand. The password is required either way.
KOLIBRI_PROVISIONDEVICE_FACILITY=Centre Name
KOLIBRI_PROVISIONDEVICE_SUPERUSERNAME=centreadmin
KOLIBRI_PROVISIONDEVICE_SUPERUSERPASSWORD=change-me-long-random
KOLIBRI_LANG=en

# --- MindSpark roster (read-only) ---
# Never 127.0.0.1: inside the container that is the container itself.
# - MongoDB on this same server, listening on all interfaces: use the
#   gateway of Kolibri's Docker network, 172.30.50.1 (with the default
#   LSHE_DOCKER_SUBNET), which does not change if the LAN address does.
# - MongoDB on another machine: use that machine's LAN address.
# Use MindSpark's existing login: the import only reads. Don't create or
# change MindSpark users for it.
MINDSPARK_MONGO_URI=mongodb://<user>:<password>@172.30.50.1:27017/?authSource=admin

# --- Teacher channels (never visible to learners, left out of reports) ---
# Comma-separated channel ids of the teacher channels (CSE course for
# teachers, ICT in Education, AI in Education).
LSHE_TEACHER_CHANNEL_IDS=

# --- Optional ---
# TZ=Africa/Lusaka
# LSHE_REPORT_TIMEZONE=Africa/Lusaka
# Channel packs to import (import_channels.sh, get_content.sh).
# LSHE_CONTENT_DIR=/srv/lshe-content
# Channel packs made from this server (export_channels.sh).
# LSHE_EXPORT_DIR=/srv/lshe-export
# Where kolibri_helper_scripts is checked out on the host.
# LSHE_HELPER_SCRIPTS_DIR=/opt/lshe/kolibri_helper_scripts
# LSHE_DOCKER_SUBNET=172.30.50.0/24
