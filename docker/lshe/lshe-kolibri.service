# Starts LSHE Kolibri (this folder's Docker Compose set-up) when the server
# boots, with no command needed, once the network address it listens on is
# up; retries if that fails. Install (as root):
#
#   cp lshe-kolibri.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now lshe-kolibri.service
#
# Adjust WorkingDirectory if the Kolibri checkout is not /opt/lshe/kolibri.
# See docs/lshe/deployment.md, "Start on boot".

[Unit]
Description=LSHE Kolibri (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lshe/kolibri/docker/lshe
ExecStartPre=/opt/lshe/kolibri/docker/lshe/wait-for-address.sh 120
# Also starts the containers again after a `docker compose stop`, which the
# containers' own "restart: unless-stopped" would leave stopped.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600
# A boot where the network came up late: try again every minute.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
